# CertAuth Environment Configuration
# Copy this file to .env and fill in your values before running.

# ── Flask ──────────────────────────────────────────────────────────────────
# Set to 'production' on Render, 'development' locally
FLASK_ENV=production

# Flask session secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required. If missing, an ephemeral random key is generated (sessions reset on each restart).
SECRET_KEY=your_strong_random_secret_key_here

# ── Application URL ────────────────────────────────────────────────────────
# Required in production — used to build QR codes and verification URLs.
# Set this to your Render URL (e.g., https://certauth.onrender.com)
BASE_URL=https://your-app.onrender.com

# ── AI Extraction (Google Gemini) ──────────────────────────────────────────
# Required. Obtain a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Specify a preferred Gemini model.
# Recommended: gemini-1.5-flash (fast + accurate)
GEMINI_MODEL=gemini-1.5-flash

# ── Admin Access ───────────────────────────────────────────────────────────
# Required in production to access:
#   - GET /ledger                  (blockchain ledger UI — via X-Admin-Key header)
#   - GET /api/blockchain          (full chain JSON — via X-Admin-Key header)
#   - GET /api/export              (full data export — via X-Admin-Key header, requires ENABLE_ADMIN_EXPORT=true)
# Generate a strong value with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Pass via HTTP header X-Admin-Key, NOT as a URL query parameter.
ADMIN_API_KEY=your_strong_random_admin_key_here

# ── Admin Data Export ──────────────────────────────────────────────────────
# Set to 'true' to enable the /api/export endpoint (disabled by default for safety)
# Requires ADMIN_API_KEY header to be set even when enabled.
ENABLE_ADMIN_EXPORT=false
